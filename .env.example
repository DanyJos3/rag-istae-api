# Copie este archivo como .env (no se sube al repositorio) y complete la clave.

# Obligatoria: API key del proveedor (OpenRouter por defecto)
LLM_API_KEY=

# Opcionales (valores por defecto)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Respaldo si el principal está caído (lista JSON; solo modelos :free; [] para desactivarlo)
# LLM_FALLBACK_MODELS=["nvidia/nemotron-3.5-super-vl:free"]
# LLM_REASONING_EFFORT=medium
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_START_TIMEOUT_SECONDS=150   (si el modelo no empieza a responder, se usa el respaldo)

# A = contexto largo, AJ = contexto largo + jerarquía normativa
# VARIANT=A
# MAX_HISTORY_MESSAGES=6

# Orígenes del frontend autorizados (lista JSON)
# CORS_ORIGINS=["http://localhost:3000"]
