# Copie este archivo como .env (no se sube al repositorio) y complete la clave.

# Obligatoria: API key del proveedor (OpenRouter por defecto)
LLM_API_KEY=

# Obligatoria: contraseña compartida con el servicio de recuperación (rag-istae-query).
# Mismo nombre y valor en ambos; la guía de integración la llama RETRIEVAL_API_KEY.
RAG_API_KEY=

# Servicio de recuperación para las arquitecturas B y C (valores por defecto)
# RETRIEVAL_URL=http://127.0.0.1:8100
# RETRIEVAL_TIMEOUT_SECONDS=90

# true solo para reproducir las arquitecturas históricas de contexto largo (A y A+J)
# ENABLE_LONG_CONTEXT=false

# Opcionales (valores por defecto)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Clave de otra cuenta si la principal se queda sin cupo (mismo modelo)
# LLM_BACKUP_API_KEY=
# Modelos de respaldo si el principal está caído (lista JSON; solo modelos :free; vacío por defecto)
# LLM_FALLBACK_MODELS=["nvidia/nemotron-3.5-super-vl:free"]
# LLM_REASONING_EFFORT=medium
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_START_TIMEOUT_SECONDS=150   (si el modelo no empieza a responder, se usa el respaldo)

# MAX_HISTORY_MESSAGES=6

# Orígenes del frontend autorizados (lista JSON)
# CORS_ORIGINS=["http://localhost:3000"]
